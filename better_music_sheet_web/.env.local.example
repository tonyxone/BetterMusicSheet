# Copy to .env.local for local dev (gitignored).
#
# Cognito/NextAuth env vars are intentionally not here right now - auth was
# removed from this app for now (see the backend's GUEST_USER_ID in auth.py).
# When it comes back, this file previously had COGNITO_CLIENT_ID/SECRET/
# ISSUER/DOMAIN and AUTH_SECRET/AUTH_URL - check git history for the exact
# shape, or ../infra's `terraform output` for the Cognito values.
#
# Point this at your local backend (`.venv\Scripts\python.exe server.py`,
# see the repo root README) - use the production URL only when building for
# a real deployment.

NEXT_PUBLIC_API_BASE=http://localhost:8000
