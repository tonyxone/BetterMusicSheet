# Copy to .env.local for local dev (gitignored).
#
# Point this at your local backend (`.venv\Scripts\python.exe server.py`,
# see the repo root README) - use the production URL only when building for
# a real deployment.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Cognito sign-in. OPTIONAL: leave both unset and the app still works
# end-to-end as a guest - the Sign in button simply doesn't render (see
# lib/cognito.ts). Sign-in happens in the app's own modal, calling Cognito's
# API directly, so there is no hosted-UI domain or callback URL involved.
#
# Both values come from ../infra's `terraform output`. They are public
# identifiers, not secrets - they ship in the JS bundle by design.
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Social sign-in (Google/Apple/Facebook), OPTIONAL - the whole app, including
# password sign-in, works with these unset. Both come from `terraform output`
# once at least one provider has credentials configured (see
# infra/cognito-idp.tf and infra/serverless.tfvars.example).
#
# NEXT_PUBLIC_COGNITO_DOMAIN is the hosted-UI base URL (output
# cognito_hosted_ui_domain) - Cognito redirects through it for the one part
# of sign-in a password flow doesn't need: the provider's own login page.
#
# NEXT_PUBLIC_COGNITO_SOCIAL_PROVIDERS is a comma list of which buttons to
# show (output cognito_social_providers, e.g. "Google,Apple") - there is no
# button for a provider that isn't actually configured on the pool.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_SOCIAL_PROVIDERS=
