# Copy to .env.local for local dev (gitignored).
#
# No Cognito/NextAuth env vars - this app has no real accounts. Every visitor
# is identified by an anonymous per-browser guest id instead (see
# lib/guest-id.ts and the backend's auth.py). If real sign-in ever comes
# back, check git history for the Cognito-based env var shape this file
# previously had.
#
# Point this at your local backend (`.venv\Scripts\python.exe server.py`,
# see the repo root README) - use the production URL only when building for
# a real deployment.

NEXT_PUBLIC_API_BASE=http://localhost:8000
