# Copy to .env for local development (gitignored). Real environment variables
# take precedence, so this never overrides a deployed configuration.
#
# Only needed to sign in locally. Without these the server still runs and
# every guest flow works - uploading, annotating, downloading - but the token
# exchange has no user pool to verify against and returns a clear 503.
#
# Values come from ../infra's `terraform output`:
#   COGNITO_USER_POOL_ID   <- cognito_user_pool_id
#   COGNITO_APP_CLIENT_ID  <- cognito_app_client_id
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
SUBSCRIPTIONS_TABLE=

# Stripe secret API key, used only by checkout and cancellation endpoints.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret from the webhook endpoint configuration.
STRIPE_WEBHOOK_SECRET=
# Stripe recurring Price ID for the monthly plan.
STRIPE_PRICE_MONTHLY=
# Stripe recurring Price ID for the yearly plan.
STRIPE_PRICE_YEARLY=

# App Store Connect API key ID for App Store Server API requests.
APPLE_KEY_ID=
# App Store Connect issuer UUID for the API key.
APPLE_ISSUER_ID=
# Numeric App Store app ID used by Apple billing configuration.
APPLE_APP_ID=
# iOS bundle identifier accepted in App Store notifications.
APPLE_BUNDLE_ID=
# Multiline App Store Connect .p8 private key used to sign client JWTs.
APPLE_PRIVATE_KEY=
# App Store Server API environment: sandbox or production.
APPLE_ENV=
# App Store subscription product ID for the monthly plan.
APPLE_PRODUCT_MONTHLY=
# App Store subscription product ID for the yearly plan.
APPLE_PRODUCT_YEARLY=

# Optional: defaults to us-west-1.
# AWS_REGION=us-west-1
