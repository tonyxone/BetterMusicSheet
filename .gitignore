# Python environment
.venv/
__pycache__/
*.pyc

# Bundled third-party OMR engine (166MB, AGPL-3.0-licensed, downloaded separately -
# see README for setup instructions instead of committing it)
tools/Audiveris/

# Input sheet-music PDFs and their annotated outputs - these are other people's
# copyrighted music (some explicitly marked "sharing and photocopying prohibited"
# by the source they were downloaded from), not this project's code, and must
# not be redistributed via this repo.
sheet/
output/

# Runtime job storage / logs for server.py (server_jobs/ holds uploaded PDFs too -
# same copyright concern as above)
server_jobs/
server.log
# Dev-server and test output captured to files while debugging.
*.log
tmp/

# One-off AWS setup files (contain the account ID) - not project code
.aws-setup/

# Editor/IDE
.idea/

# Claude Code session state (local-only, not meant for the public repo)
.claude/
# Terraform source is reviewable; state, saved plans and personal values are not.
infra/**/.terraform/
infra/**/*.tfstate*
infra/**/tfplan*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/backend.hcl

# Local backend config (Cognito ids for local sign-in) - see .env.example
.env
